%YAML 1.2
---
name: Pawn
file_extensions:
  - sma
  - inc
  - pwn
scope: source.pawn

contexts:
  main:
    # Comments
    - match: '//.*$'
      scope: comment.line.double-slash.pawn
    - match: '/\*'
      scope: punctuation.definition.comment.begin.pawn
      push: block-comment

    # Preprocessor
    - match: '^\s*(#\w+)'
      captures:
        1: keyword.control.import.pawn

    # Strings
    - match: '"'
      scope: punctuation.definition.string.begin.pawn
      push: double-quoted-string
    - match: "'"
      scope: punctuation.definition.string.begin.pawn
      push: single-quoted-string

    # Numbers
    - match: '\b0x[0-9a-fA-F]+\b'
      scope: constant.numeric.hex.pawn
    - match: '\b\d+(\.\d+)?\b'
      scope: constant.numeric.decimal.pawn

    # Storage types & modifiers
    - match: '\b(new|static|stock|public|native|forward|const)\b'
      scope: storage.type.pawn

    # Tags
    - match: '\b(Float|bool|any|String):'
      captures:
        1: storage.type.tag.pawn

    # Control keywords
    - match: '\b(if|else|switch|case|default|while|do|for|return|break|continue)\b'
      scope: keyword.control.pawn

    # Built-in constants
    - match: '\b(true|false|cellmin|cellmax)\b'
      scope: constant.language.pawn

    # Operators
    - match: '(\+|\-|\*|/|%|=|==|!=|<=|>=|<|>|&&|\|\||!|~|&|\||\^)'
      scope: keyword.operator.pawn

    # Function call
    - match: '\b([A-Za-z_@][\w@]*)(\s*\()'
      captures:
        1: entity.name.function.pawn
        2: punctuation.section.group.begin.pawn

  block-comment:
    - match: '\*/'
      scope: punctuation.definition.comment.end.pawn
      pop: true
    - match: '.'
      scope: comment.block.pawn

  double-quoted-string:
    - match: '\\.'
      scope: constant.character.escape.pawn
    - match: '"'
      scope: punctuation.definition.string.end.pawn
      pop: true
    - match: '.'
      scope: string.quoted.double.pawn

  single-quoted-string:
    - match: '\\.'
      scope: constant.character.escape.pawn
    - match: "'"
      scope: punctuation.definition.string.end.pawn
      pop: true
    - match: '.'
      scope: string.quoted.single.pawn
